# ---- Витрина (публичные, попадают в сборку) ----
# Публичный адрес сайта: canonical, sitemap, Open Graph
VITE_SITE_URL=https://sosukii.github.io/greenol-shop
# ID счётчика Яндекс Метрики. Пусто — счётчик не подключается
VITE_YM_ID=
# Адрес бэкенда. Пусто — локальный режим (данные хранятся в браузере)
VITE_API_URL=
# sandbox | live  (live — только после подключения банка и подтверждения заказчика)
VITE_PAYMENT_MODE=sandbox

# ---- Бэкенд (серверные секреты, НЕ коммитить) ----
PORT=8787
DATA_FILE=./server/data/shop.db
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=сгенерируйте-длинную-случайную-строку
ADMIN_USER=admin
# node scripts/hash-password.mjs "ваш-пароль"
ADMIN_PASSWORD_HASH=
PAYMENT_WEBHOOK_SECRET=секрет-из-кабинета-банка
PAYMENT_MODE=sandbox
# true, если витрина на другом домене (GitHub Pages): cookie SameSite=None
CROSS_SITE_COOKIES=false
